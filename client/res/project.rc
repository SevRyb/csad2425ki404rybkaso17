	    VALUE "OriginalFilename", "TicTacToe.exe"
	    VALUE "ProductName", "TicTacToe 3x3 by SevRyb"
	    VALUE "ProductVersion", "1, 0, 0, 0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
